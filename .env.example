# Replace the placeholders with your existing PostgreSQL connection details.
# Percent-encode special characters in the username and password.
# Add the SSL parameters required by your database provider.
DATABASE_URL="postgresql://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE?schema=public"

# Exact, distinct HTTPS origins; Admin Web proxies /api/v1 on its own origin.
ADMIN_ORIGIN="https://admin.example.test"
USER_ORIGIN="https://quote.example.test"
HOST="127.0.0.1"
PORT="3000"
# Separate private operations listener; never expose through public ingress.
OPS_HOST="127.0.0.1"
OPS_PORT="3001"
# Enable Swagger only on a local/private interface; leave disabled for deployment.
ENABLE_API_DOCS="false"
# Explicit proxy IPs/CIDRs only, never true or a hop count.
TRUST_PROXY="false"
# Stable UUID outside PostgreSQL; replace after lossy restore.
RECOVERY_EPOCH="YOUR_ENVIRONMENT_UUID"
# Independent 32-byte random keys in standard base64. Never reuse keys.
CSRF_HMAC_KEY="YOUR_BASE64_32_BYTE_KEY"
RATE_LIMIT_HMAC_KEY="YOUR_DIFFERENT_BASE64_32_BYTE_KEY"
REVIEW_HMAC_KEY="YOUR_DIFFERENT_BASE64_32_BYTE_KEY"
OPERATION_HMAC_KEYS='{"v1":"YOUR_DIFFERENT_BASE64_32_BYTE_KEY"}'
OPERATION_HMAC_CURRENT_KEY_ID="v1"
VIEWING_LINK_KEYS='{"v1":"YOUR_DIFFERENT_BASE64_32_BYTE_KEY"}'
VIEWING_LINK_CURRENT_KEY_ID="v1"
# TEST_DATABASE_URL is separate and must reference a disposable migrated
# database whose name ends in _test. Never point tests at company data.
